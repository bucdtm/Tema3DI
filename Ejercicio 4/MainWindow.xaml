<Window x:Class="Ejercicio4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="INVENTARIO MATISSE" Height="680" Width="1000"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="#333333"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <!-- Estilo para los botones del menú hamburguesa -->
        <Style x:Key="HamburgerMenuItemStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/> <!-- Barra superior índigo -->
            <RowDefinition Height="*"/>   <!-- Contenedor principal con sidebar hamburguesa -->
        </Grid.RowDefinitions>

        <!-- Barra superior (Índigo/Morado con título) -->
        <Border Grid.Row="0" Background="#5C6BC0">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <materialDesign:PackIcon Kind="Layers" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="INVENTARIO MATISSE" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0" Margin="2,0" ToolTip="Usuario">
                        <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0" Margin="2,0" ToolTip="Minimizar" Click="BtnMinimizar_Click">
                        <materialDesign:PackIcon Kind="Minus" Width="18" Height="18" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0" Margin="2,0" ToolTip="Maximizar" Click="BtnMaximizar_Click">
                        <materialDesign:PackIcon Kind="WindowMaximize" Width="18" Height="18" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0" Margin="2,0" ToolTip="Cerrar" Click="BtnCerrar_Click">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenedor del Hamburger Menu y Contenido Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="navColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barra lateral Hamburger (Gris oscuro / Charcoal) -->
            <Border Grid.Column="0" Background="#37474F">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Botón Hamburguesa -->
                        <RowDefinition Height="*"/>    <!-- Elementos del menú -->
                        <RowDefinition Height="Auto"/> <!-- Elemento inferior: Ayuda -->
                    </Grid.RowDefinitions>

                    <!-- Botón Hamburguesa superior -->
                    <Button Grid.Row="0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="50"
                            HorizontalContentAlignment="Left"
                            Padding="18,0"
                            ToolTip="Alternar menú hamburguesa"
                            Click="BtnHamburger_Click">
                        <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" Foreground="#ECEFF1"/>
                    </Button>

                    <!-- Lista de opciones del menú hamburguesa -->
                    <StackPanel Grid.Row="1" Margin="0,5">
                        <Button Style="{StaticResource HamburgerMenuItemStyle}" Click="MenuOption_Click" Tag="Préstamos">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sync" Width="22" Height="22" Foreground="#ECEFF1" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Préstamos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource HamburgerMenuItemStyle}" Click="MenuOption_Click" Tag="Búsquedas">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" Foreground="#ECEFF1" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Búsquedas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource HamburgerMenuItemStyle}" Click="MenuOption_Click" Tag="Artículos">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookMultipleOutline" Width="22" Height="22" Foreground="#ECEFF1" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Artículos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource HamburgerMenuItemStyle}" Click="MenuOption_Click" Tag="Administración">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WrenchOutline" Width="22" Height="22" Foreground="#ECEFF1" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Administración" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource HamburgerMenuItemStyle}" Click="MenuOption_Click" Tag="Inventario">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted" Width="22" Height="22" Foreground="#ECEFF1" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Inventario" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource HamburgerMenuItemStyle}" Click="MenuOption_Click" Tag="Información">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrendingUp" Width="22" Height="22" Foreground="#ECEFF1" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Informacion" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Opción inferior de Ayuda -->
                    <Border Grid.Row="2" BorderBrush="#455A64" BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource HamburgerMenuItemStyle}" Height="52" Click="MenuOption_Click" Tag="Ayuda">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="22" Height="22" Foreground="#ECEFF1" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="? Ayuda" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- Área de contenido a la derecha -->
            <Border Grid.Column="1" Background="#ECEFF1" Padding="30">
                <materialDesign:Card Padding="30" VerticalAlignment="Top" Margin="10">
                    <StackPanel>
                        <TextBlock x:Name="lblTituloSeccion"
                                   Text="Bienvenido al menú Hamburguesa de Inventario Matisse"
                                   FontSize="20" FontWeight="Bold" Foreground="#37474F"/>
                        <TextBlock x:Name="lblDescripcionSeccion"
                                   Text="Haz clic en el icono hamburguesa superior para colapsar o expandir el menú lateral, o selecciona una de las opciones."
                                   Margin="0,12,0,0" FontSize="14" Foreground="#607D8B"/>
                    </StackPanel>
                </materialDesign:Card>
            </Border>
        </Grid>
    </Grid>
</Window>
