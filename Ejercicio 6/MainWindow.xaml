<Window x:Class="Ejercicio6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Tema3.Ejercicio6" Height="620" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        TextElement.Foreground="#333333"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <!-- Estilo para los botones de la columna izquierda (Your Stage) -->
        <Style x:Key="StageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#37474F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para los botones de la columna Tasks -->
        <Style x:Key="TaskNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECEFF1"/>
                    <Setter Property="Foreground" Value="#263238"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/> <!-- Barra superior -->
            <RowDefinition Height="*"/>   <!-- Contenedor de 3 columnas -->
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border Grid.Row="0" Background="#2E3B4E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/> <!-- Botón Dashboard -->
                    <ColumnDefinition Width="180"/> <!-- Botón Tasks -->
                    <ColumnDefinition Width="*"/>   <!-- Add Item, Selection Title, y controles -->
                </Grid.ColumnDefinitions>

                <!-- 1. Botón Dashboard (Verde azulado) -->
                <Button Grid.Column="0"
                        Background="#26A69A"
                        Foreground="White"
                        BorderThickness="0"
                        Height="50"
                        Click="NavHeader_Click"
                        Tag="Dashboard">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Dashboard" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 2. Botón Tasks (Verde azulado oscuro) -->
                <Button Grid.Column="1"
                        Background="#00897B"
                        Foreground="White"
                        BorderThickness="0"
                        Height="50"
                        Click="NavHeader_Click"
                        Tag="Tasks">
                    <DockPanel HorizontalAlignment="Stretch" Width="150">
                        <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock Text="Tasks" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    </DockPanel>
                </Button>

                <!-- 3. Sección derecha: Add Item (botón), Selection Title (texto) y botones de acción -->
                <DockPanel Grid.Column="2" LastChildFill="True">
                    <!-- Botón + Add Item -->
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#80CBC4"
                            Foreground="White"
                            Height="32"
                            Padding="12,0"
                            Margin="15,0,0,0"
                            DockPanel.Dock="Left"
                            Click="BtnAddItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Item" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Botones de la derecha (Ajustes y salir) -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Width="36" Height="36" Padding="0" Click="BtnSettings_Click" ToolTip="Configuración">
                            <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" Foreground="#B0BEC5"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Width="36" Height="36" Padding="0" Click="BtnLogout_Click" ToolTip="Cerrar sesión">
                            <materialDesign:PackIcon Kind="Power" Width="18" Height="18" Foreground="#B0BEC5"/>
                        </Button>
                    </StackPanel>

                    <!-- Texto "Selection Title" (NO es botón, tal como especifica el PDF) -->
                    <TextBlock Text="Selection Title"
                               Foreground="#CFD8DC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL (3 COLUMNAS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/> <!-- Columna 1: Your Stage (Botones) -->
                <ColumnDefinition Width="180"/> <!-- Columna 2: Tasks (Botones) -->
                <ColumnDefinition Width="*"/>   <!-- Columna 3: Card con doble borde y DropShadowEffect -->
            </Grid.ColumnDefinitions>

            <!-- COLUMNA 1: YOUR STAGE (Fondo oscuro) -->
            <Border Grid.Column="0" Background="#2E3B4E" Padding="0,15">
                <StackPanel>
                    <TextBlock Text="Your Stage" Foreground="#78909C" FontSize="11" FontWeight="Bold" Margin="16,0,0,12"/>

                    <!-- Todos son botones según características a implementar -->
                    <Button Style="{StaticResource StageButtonStyle}" Click="StageButton_Click" Tag="Guide">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CubeOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Guide" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource StageButtonStyle}" Click="StageButton_Click" Tag="Notification">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BellOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Notification" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource StageButtonStyle}" Click="StageButton_Click" Tag="Features">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TagOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Features" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource StageButtonStyle}" Click="StageButton_Click" Tag="Map Marker">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MapMarkerOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Map Marker" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource StageButtonStyle}" Click="StageButton_Click" Tag="Assistant">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Headset" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Assistant" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- COLUMNA 2: TASKS (Botones que incluyen sus números) -->
            <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="0,15">
                <StackPanel>
                    <!-- Botón Inbox (con número 3) -->
                    <Button Style="{StaticResource TaskNavButtonStyle}" Click="TaskNavButton_Click" Tag="Inbox">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <materialDesign:PackIcon Kind="EmailOutline" Width="18" Height="18" Foreground="#78909C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Inbox" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="3" HorizontalAlignment="Right" Foreground="#78909C" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>

                    <!-- Botón Draft (con número 2) -->
                    <Button Style="{StaticResource TaskNavButtonStyle}" Click="TaskNavButton_Click" Tag="Draft">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="18" Height="18" Foreground="#78909C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Draft" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="2" HorizontalAlignment="Right" Foreground="#78909C" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>

                    <!-- Botón Deleted (con número 1) -->
                    <Button Style="{StaticResource TaskNavButtonStyle}" Click="TaskNavButton_Click" Tag="Deleted">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <materialDesign:PackIcon Kind="EmailRemoveOutline" Width="18" Height="18" Foreground="#78909C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Deleted" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="1" HorizontalAlignment="Right" Foreground="#78909C" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>

                    <!-- Botón Sent (con número 5) -->
                    <Button Style="{StaticResource TaskNavButtonStyle}" Click="TaskNavButton_Click" Tag="Sent">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <materialDesign:PackIcon Kind="At" Width="18" Height="18" Foreground="#78909C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sent" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="5" HorizontalAlignment="Right" Foreground="#78909C" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- COLUMNA 3: RECTÁNGULO SOMBREADO CON DOBLE BORDE (Según especificación exacta del PDF) -->
            <Grid Grid.Column="2" Margin="15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Implementación literal del snippet solicitado en el PDF -->
                <!-- Borde 1 con DropShadowEffect -->
                <Border Margin="10" BorderBrush="#cccccc" BorderThickness="1" Background="White" Grid.Row="1" Grid.ColumnSpan="4">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2"/>
                    </Border.Effect>
                </Border>

                <!-- Borde 2 con Grid de contenido -->
                <Border Margin="10" BorderBrush="#cccccc" BorderThickness="1" Grid.Row="1" Grid.ColumnSpan="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                        </Grid.RowDefinitions>

                        <!-- Fila 1: A Task with Calendar -->
                        <Border Grid.Row="0" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="15,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CalendarToday" Width="20" Height="20" Foreground="#1E88E5" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="A Task with Calendar" FontSize="13" Foreground="#37474F" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20" Foreground="#78909C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Fila 2: Planner -->
                        <Border Grid.Row="1" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="15,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FormatListChecks" Width="20" Height="20" Foreground="#00ACC1" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Planner" FontSize="13" Foreground="#37474F" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="MapMarkerOutline" Width="20" Height="20" Foreground="#78909C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Fila 3: Notes -->
                        <Border Grid.Row="2" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="15,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="NotebookOutline" Width="20" Height="20" Foreground="#7E57C2" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Notes" FontSize="13" Foreground="#37474F" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="StarOutline" Width="20" Height="20" Foreground="#78909C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Fila 4: Unit -->
                        <Border Grid.Row="3" Padding="15,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="SitemapOutline" Width="20" Height="20" Foreground="#43A047" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Unit" FontSize="13" Foreground="#37474F" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="AccountOutline" Width="20" Height="20" Foreground="#78909C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Pie informativo / Feedback de acciones -->
                <TextBlock x:Name="lblStatus"
                           Grid.Row="2" Grid.ColumnSpan="4"
                           Text="Seleccione una acción o tarea"
                           Foreground="#9E9E9E" FontSize="13"
                           Margin="14,10,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
